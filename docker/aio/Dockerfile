# AIO Webtoon Downloader, containerised.
#
# There is no published image, which is why this repository owns a Dockerfile:
# the alternative was Python plus a Chromium install on the Windows host, and
# the rule here is that anything with moving parts is a container.
#
# Build it through Compose rather than by hand:
#     docker compose --profile manga build aio
#
# Pinned to a tag on purpose. This is a scraper for sites that change without
# notice, so it will need bumping - but a build that silently changes under you
# is worse than one you update deliberately.
FROM python:3.12-slim

ARG AIO_REF=v0.0.6.0

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/browsers

# libvips is optional to the downloader - it falls back to Pillow - but it is
# roughly twice as fast on the WebP save path, and it is one apt package.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git libvips42 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN git clone --depth 1 --branch "${AIO_REF}" \
      https://github.com/zzyil/AIO-Webtoon-Downloader.git . \
    && python -m pip install --upgrade pip \
    && python -m pip install -r requirements.txt

# MangaFire needs a real browser: its image URLs are behind a VRF token that is
# generated by page script, and several Cloudflare-protected sites are solved
# the same way. --with-deps is what pulls the ~100 shared libraries Chromium
# needs, which is the bulk of this image's size.
RUN python -m patchright install --with-deps chromium

# Deliberately root, and deliberately not PUID/PGID like the linuxserver
# images: Chromium's sandbox and the browser cache both live outside /data, and
# a Docker Desktop bind mount ignores ownership anyway. On a Linux host this
# would need revisiting.
ENTRYPOINT ["python", "aio-dl.py"]
CMD ["--help"]
