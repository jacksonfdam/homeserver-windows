# Local configuration. Holds real paths, the LAN address and API keys.
# .env.example is the template that ships; .env never is.
.env

# Generated by Import-MangaLists.ps1: list exports, match reports, backlogs.
lists/

# MangaBaka mirror: a 533 MB archive that unpacks to a 3.3 GB database.
mangabaka/
*.sqlite
*.sqlite3
*.jsonl
*.tar.gz
*.zst

# Homepage config backups written by New-Dashboard.ps1
*.bak-*

# macOS / Windows noise
.DS_Store
Thumbs.db
desktop.ini

# Tombstones the SMB server leaves behind when a file on the share is replaced
# while something still has it open. This repo is normally worked on over such
# a share, so they turn up often enough to be worth ignoring.
.smbdelete*
