# Local configuration. Holds real paths, the LAN address and API keys.
# .env.example is the template that ships; .env never is.
.env

# Generated by Import-MangaLists.ps1: list exports, match reports, backlogs.
lists/

# MangaBaka database dump (~3 GB) and anything unpacked from it.
mangabaka/
*.sqlite
*.sqlite3
*.jsonl
*.tar.gz
*.zst

# Homepage config backups written by New-Dashboard.ps1
*.bak-*

# macOS / Windows noise
.DS_Store
Thumbs.db
desktop.ini

# Byte-identical duplicate of .env.example, and a pre-Homepage snapshot of the
# compose file. Both kept on disk for reference; git history covers the job.
.env2.example
docker-compose.old.yml
