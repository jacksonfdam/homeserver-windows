# Copy to .env (Setup-HomeServer.ps1 does this for you) and edit.
# IMPORTANT: use forward slashes in every path, even for Windows drives.
#   correct:   C:/media
#   broken:    C:\media

# Where the library and downloads live. Must be ONE root: everything the *arr
# apps touch has to sit under it, or you lose atomic moves and hardlinks.
DATA_ROOT=C:/media

# Where each container keeps its own configuration/database.
CONFIG_ROOT=C:/homeserver/config

# Transcode scratch space. An SSD is a good idea here.
CACHE_ROOT=C:/homeserver/cache

# LAN IP of this Windows machine. Used by Plex ADVERTISE_IP and Jellyfin's
# published URL, because host networking does not exist on Docker Desktop.
# Setup-HomeServer.ps1 detects this and writes it back.
HOST_IP=192.168.1.10

TZ=Europe/Stockholm
PUID=1000
PGID=1000
UMASK=002

# --- ports (change only if something else on Windows already listens there) ---
QBT_WEBUI_PORT=8080
QBT_TORRENT_PORT=6881
SABNZBD_PORT=8085
PROWLARR_PORT=9696
FLARESOLVERR_PORT=8191
SONARR_PORT=8989
RADARR_PORT=7878
LIDARR_PORT=8686
BAZARR_PORT=6767
JELLYFIN_PORT=8096
JELLYSEERR_PORT=5055
SEERR_PORT=5056
KOMGA_PORT=25600
KAVITA_PORT=5001
HOMEPAGE_PORT=3000
PORTAINER_PORT=9000

# Optional: claim token from https://plex.tv/claim (valid for 4 minutes).
# Only needed the first time you start the plex profile.
PLEX_CLAIM=

# --- Homepage dashboard ---------------------------------------------------
# Homepage refuses to render without this, and it must list every host:port you
# open the dashboard from. New-Dashboard.ps1 fills it in from HOST_IP.
HOMEPAGE_ALLOWED_HOSTS=localhost:3000

# Credentials the dashboard widgets need. New-Dashboard.ps1 reads the
# Sonarr/Radarr/Lidarr/Prowlarr/Bazarr keys out of the running containers, but
# these cannot be discovered, so the generated config references them as
# {{HOMEPAGE_VAR_*}} and the values stay here instead of in the YAML.
# Left empty, those widgets show "API Error" until you fill them in.
#   Jellyfin:    Dashboard > Advanced > API Keys
#   Komga:       the account you log in with
#   Kavita:      the account you log in with (needs Admin, or stats 403s)
#   qBittorrent: 4.6.1+ logs a random password on first start, so read it with
#                docker logs qbittorrent | Select-String -Pattern "password"
HOMEPAGE_VAR_JELLYFIN_KEY=
HOMEPAGE_VAR_KOMGA_USER=
HOMEPAGE_VAR_KOMGA_PASSWORD=
HOMEPAGE_VAR_KAVITA_USER=
HOMEPAGE_VAR_KAVITA_PASSWORD=
HOMEPAGE_VAR_QBT_KEY=
HOMEPAGE_VAR_QBT_USER=admin
HOMEPAGE_VAR_QBT_PASSWORD=

# --- manga ----------------------------------------------------------------
# API keys used by Import-MangaLists.ps1 (optional).
# Komga: UI > Account settings > API keys (needs the ADMIN role)
# Kavita: UI > Settings > Account > API Key
KOMGA_API_KEY=
KAVITA_API_KEY=

# Where Update-MangaBaka.ps1 keeps the local MangaBaka mirror. Regenerable, so
# deliberately not under CONFIG_ROOT, which is what the backup instructions in
# README.md cover. Defaults to <CACHE_ROOT>/mangabaka when left empty.
MANGABAKA_ROOT=
